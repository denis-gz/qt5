From: Denis Zavorotnyy <denis.zavorotnyy@nurd.com>
Subject: [PATCH] Fix V8 build with Apple clang 16 (Xcode 16)

Apple clang 16 makes -Wenum-constexpr-conversion an error: base::BitField
computes kMax = static_cast<T>(2^bits - 1), which is outside the range of
an enum without a fixed underlying type when the enum has fewer values
than the field can hold (WasmCode::Kind, LocationOperand::LocationKind,
and AddressingMode on arm64). Give these enums one, the same way as
upstream d2d822b01 (Fix clang 16 build on macOS) did for other V8 enums.
---
diff --git a/chromium/v8/src/compiler/backend/instruction-codes.h b/chromium/v8/src/compiler/backend/instruction-codes.h
index 8772a78df..7552f535e 100644
--- a/chromium/v8/src/compiler/backend/instruction-codes.h
+++ b/chromium/v8/src/compiler/backend/instruction-codes.h
@@ -187,7 +187,7 @@ V8_EXPORT_PRIVATE std::ostream& operator<<(std::ostream& os,
   V(None)                       \
   TARGET_ADDRESSING_MODE_LIST(V)
 
-enum AddressingMode {
+enum AddressingMode : uint8_t {
 #define DECLARE_ADDRESSING_MODE(Name) kMode_##Name,
   ADDRESSING_MODE_LIST(DECLARE_ADDRESSING_MODE)
 #undef DECLARE_ADDRESSING_MODE
diff --git a/chromium/v8/src/compiler/backend/instruction.h b/chromium/v8/src/compiler/backend/instruction.h
index 041992879..b85c21e2b 100644
--- a/chromium/v8/src/compiler/backend/instruction.h
+++ b/chromium/v8/src/compiler/backend/instruction.h
@@ -467,7 +467,7 @@ class PendingOperand : public InstructionOperand {
 
 class LocationOperand : public InstructionOperand {
  public:
-  enum LocationKind { REGISTER, STACK_SLOT };
+  enum LocationKind : uint8_t { REGISTER, STACK_SLOT };
 
   LocationOperand(InstructionOperand::Kind operand_kind,
                   LocationOperand::LocationKind location_kind,
diff --git a/chromium/v8/src/wasm/wasm-code-manager.h b/chromium/v8/src/wasm/wasm-code-manager.h
index 5e8ed5475..590094b36 100644
--- a/chromium/v8/src/wasm/wasm-code-manager.h
+++ b/chromium/v8/src/wasm/wasm-code-manager.h
@@ -116,7 +116,7 @@ class V8_EXPORT_PRIVATE DisjointAllocationPool final {
 
 class V8_EXPORT_PRIVATE WasmCode final {
  public:
-  enum Kind {
+  enum Kind : uint8_t {
     kFunction,
     kWasmToCapiWrapper,
     kWasmToJsWrapper,
